# ── Aphrodite Configuration ────────────────────────────────────────────────
# Copy this file to aphrodite.toml and edit to your needs.
# Priority (a subset of fields only - see docs/config/env-vars.md):
# env var > aphrodite.toml > hardcoded default.
#
# Search order: ./aphrodite.toml, then ~/.hermes/aphrodite/aphrodite.toml
# (only when APHRODITE_CONFIG_PATH is NOT set - an explicit override that
# doesn't exist falls through to single-proxy CLI-flag mode instead).
#
# Everything below is pre-configured: every section the engine reads is present
# with its current default. `aphrodite setup` writes the same structure (with
# {cache_port}/{token_port} placeholders) from the embedded template.

# ── Proxies ─────────────────────────────────────────────────────────────────
# `listen` binds loopback-only by default (report 12 F2) - the router already
# rejects non-loopback peers on everything except /health, but binding
# 0.0.0.0 still needlessly exposes an unauthenticated listener to your LAN.
# Uncomment the 0.0.0.0 lines only if you deliberately want another machine
# on your network to reach this proxy - understand that /retrieve, /history,
# and /ccr/* have no authentication of their own.
[[proxies]]
name = "cache"
listen = "127.0.0.1:9797"
# listen = "0.0.0.0:9797"  # WARNING: exposes proxy to your network
mode = "cache"
tool_relay = true
timeout = 120

[[proxies]]
name = "token"
listen = "127.0.0.1:9798"
# listen = "0.0.0.0:9798"  # WARNING: exposes proxy to your network
mode = "token"
tool_relay = true
timeout = 300

# ── Shared defaults (applied to all proxies unless overridden) ──────────────
[defaults]
# api_url / model come from APHRODITE_API_URL / APHRODITE_MODEL env vars or the
# proxy's own upstream configuration - no provider defaults are baked in.
ccr_ttl_seconds = 3600
# api_key is read from APHRODITE_API_KEY env var.
# Only uncomment if you cannot use the env var:
# api_key = "sk-..."


# ══════════════════════════════════════════════════════════════════════════════
#  COMPRESSION  -  thresholds, engine, auto-expand, classifier poll
# ══════════════════════════════════════════════════════════════════════════════
[compression]
engine_threshold_pct = 45   # default: compress at 45% context; set to 100 or higher to disable engine compression entirely (escape hatch); APHRODITE_ENGINE_THRESHOLD_PCT > TOML > default
engine_protect_first = 2    # messages to keep at start
engine_protect_last = 5     # messages to keep at end
engine_min_msgs = 8         # minimum messages before activating
tool_threshold_token = 512  # token proxy threshold (bytes) - lower = compress more
tool_threshold_cache = 4096 # cache proxy threshold (bytes) - lower = compress more
terminal_threshold = 1024   # terminal output threshold (bytes) - catch more terminal output
inline_threshold = 2048     # inline zlib fallback threshold (bytes)
auto_expand = true          # on: markers auto-expand inline - no aphrodite_retrieve needed for tool output
auto_expand_limit = 102400  # cap per-expansion at 100KB (0=unlimited, but safe cap prevents context blowout)
catalog_mode = "tool"       # compact | full | tool
classifier_poll = true      # skip CCR for clean outputs
code_multiplier = 3.0       # multiply threshold for code types
context_engine = true       # dylib-path only (aphrodite_stats/config_get/set,
# aphrodite_dispatch) - a status flag exposed by
# the C-ABI/Hermes bridge; the standalone HTTP
# proxy (main.rs/proxy.rs) never reads it and has
# no gated behavior tied to this key
prefetch = true # enable aphrodite_prefetch tool
poll_worker = true # enable auto-backgrounding of slow tool calls
chain_split = false # opt-in fine-grained command splitting (SEG_MARKER segments); OFF by default (markers pollute redirected stdout)


# ══════════════════════════════════════════════════════════════════════════════
#  PREVIEWS  -  model-aware templates, code structure maps
# ══════════════════════════════════════════════════════════════════════════════
[previews]
model_family = "code_first" # compact | code_first | balance
code_structure_map = true   # show fn/struct/class sigs
preview_max_chars = 120     # max chars per preview line (env APHRODITE_PREVIEW_MAX_CHARS > TOML > default 120; key absent = unlimited)


# ══════════════════════════════════════════════════════════════════════════════
#  PROMPTS  -  how the system instructs the LLM about CCR
# ══════════════════════════════════════════════════════════════════════════════
[prompts]
retrieve_guidance = "minimal" # minimal | standard | verbose
ccr_marker_hint = false       # append "…(use aphrodite_retrieve)"?
catalog_intent_hints = false  # show intent=read with hashes?
# First-turn session orientation injected by pre_llm_call on turn 0.
# Ships a default when this key is absent (see crates/aphrodite/src/flow.rs).
# Set to "" to disable entirely.
session_inject = """
[APHRODITE] CCR active. Tool output > threshold → <<<CCR:hash|type|size>>>.
Marker = stored content. If a marker appears, retrieve it (aphrodite_retrieve)
before any other action. Never re-read a file you hold a marker for.
OPERATING RULES (token-efficiency):
- Branch on STRUCTURED exit signals only: tool `exit_code`, `error` fields,
  and command `EXIT:$?` prints. Never infer success/failure by scanning
  human-readable text (e.g. "behind/ahead", "error:", banners).
- Write commands to be machine-checkable: end with `; echo "EXIT:$?"` and
  use `test -f`/`grep -q` so the exit code is the source of truth.
- Keep prose minimal. No declarative status paragraphs. Act, then report
  the single decisive fact (exit code / hash / file path).
- Batch independent reads; retrieve all CCR markers in one turn before acting.
"""


# ══════════════════════════════════════════════════════════════════════════════
#  TEMPLATES  -  per-content-type preview/marker/prompt format strings
#
#  Variables available in templates:
#    {type}     - content type (diff, build_output, code_rust, ...)
#    {ln}       - line count
#    {size}     - byte size
#    {hash}     - short hash (12 chars)
#    {err}      - error count
#    {warn}     - warning count
#    {exit}     - terminal exit code
#    {cmd}      - terminal command
#    {files}    - file count (diff)
#    {fn}       - filename (diff)
#    {plus}     - lines added (diff)
#    {minus}    - lines removed (diff)
#    {keys}     - JSON top-level keys
#    {items}    - item count (JSON list, table rows)
#    {msg}      - error message
#    {commit}   - commit short hash
#    {subject}  - commit subject
#    {pid}      - process ID
#    {uptime}   - process uptime
#    {fns}      - function count (code structure map)
#    {structs}  - struct count (Rust)
#    {impls}    - impl count (Rust)
#    {classes}  - class count (Python/JS)
#    {sigs}     - first 2 signatures inline
#    {first}    - first 110 chars of content
# ══════════════════════════════════════════════════════════════════════════════

# ── Preview templates: [type:...] format per content type ────────────────────
# compact family (Claude): metadata-only, pure structured format
[templates.preview.compact]

diff = "[diff:{files}f +{plus}/-{minus} {ln}L{fx}{fn}]"
# {fx} resolves to " " + {fn}[:40] if fn is set, else ""
build_output = "[build:{err}E {warn}W {ln}L]"
build_error = "[error:{code} {loc} {ln}L]"
error = "[error:{msg}]"
terminal = "[terminal:{cmx} exit={exit}]"
# {cmx} resolves to cmd[:40] stripped of leading $/>, or "?"
commit = "[commit:{commit} {subject}]"
search_files = "[grep:{files} matches {ln}L]"
search_results = "[grep:{files} matches {ln}L]"
tabular = "[table:{items} rows {ln}L]"
json = "[json:{keys} {ln}L]"
json_list = "[json:{items} items {ln}L]"
process_output = "[process:pid={pid} up={uptime} {ln}L]"
write_file = "[file:{fn} {size}B {ln}L]"
log = "[log:{entries}E {errors}E {warnings}W {ln}L]"
browser_snapshot = "[dom:{elements} elements {total} {ln}L]"
code = "[{type}:{fns}fns|{structs}structs {ln}L]"
code_rust = "[{type}:{fns}fns|{structs}structs|{impls}impls {ln}L]"
code_python = "[{type}:{fns}fns|{classes}classes {ln}L]"
code_go = "[{type}:{fns}fns|{types}types {ln}L]"
code_js = "[{type}:{fns}fns|{classes}classes {ln}L]"
_default = "[{type}:{first}]"

# ── Preview templates: code_first family (DeepSeek, Qwen) ────────────────────
# Code signatures before metadata, shows actual code the LLM can reason about
[templates.preview.code_first]

diff = "[diff:{files}f +{plus}/-{minus} {ln}L{fx}{fn}]"
build_output = "[build:{err}E {warn}W {ln}L]"
build_error = "[error:{code} {loc} {ln}L]"
error = "[error:{msg}]"
terminal = "[terminal:{cmx} exit={exit}]"
commit = "[commit:{commit} {subject}]"
search_files = "[grep:{files} matches {ln}L]"
search_results = "[grep:{files} matches {ln}L]"
tabular = "[table:{items} rows {ln}L]"
json = "[json:{keys} {ln}L]"
json_list = "[json:{items} items {ln}L]"
process_output = "[process:pid={pid} up={uptime} {ln}L]"
write_file = "[file:{fn} {size}B {ln}L]"
log = "[log:{entries}E {errors}E {warnings}W {ln}L]"
browser_snapshot = "[dom:{elements} elements {total} {ln}L]"
web_search = "[search:{total} results '{q}' {ln}L]"
image_generate = "[image:{msg} {ln}L]"
todo = "[todo:{items} items {total} pending {ln}L]"
memory = "[memory:{items} entries {ln}L]"
cronjob = "[cron:{msg} {ln}L]"
code = "[{type}:{fns}fns|{structs}structs {sigs} {ln}L]"
code_rust = "[{type}:{fns}fns|{structs}structs|{impls}impls {sigs} {ln}L]"
code_python = "[{type}:{fns}fns|{classes}classes {sigs} {ln}L]"
code_go = "[{type}:{fns}fns|{types}types {sigs} {ln}L]"
code_js = "[{type}:{fns}fns|{classes}classes {sigs} {ln}L]"
code_ts = "[{type}:{fns}fns|{classes}classes {sigs} {ln}L]"
code_sh = "[{type}:{fns}fns {sigs} {ln}L]"
_default = "[{type}:{first}]"

# ── Preview templates: balance family (GPT, Gemini) ──────────────────────────
# Metadata + first signature - enough context to decide, not full code dump
[templates.preview.balance]

diff = "[diff:{files}f +{plus}/-{minus} {ln}L{fx}{fn}]"
build_output = "[build:{err}E {warn}W {ln}L]"
build_error = "[error:{code} {loc} {ln}L]"
error = "[error:{msg}]"
terminal = "[terminal:{cmx} exit={exit}]"
commit = "[commit:{commit} {subject}]"
search_files = "[grep:{files} matches {ln}L]"
search_results = "[grep:{files} matches {ln}L]"
tabular = "[table:{items} rows {ln}L]"
json = "[json:{keys} {ln}L]"
json_list = "[json:{items} items {ln}L]"
process_output = "[process:pid={pid} up={uptime} {ln}L]"
write_file = "[file:{fn} {size}B {ln}L]"
log = "[log:{entries}E {errors}E {warnings}W {ln}L]"
browser_snapshot = "[dom:{elements} elements {total} {ln}L]"
code = "[{type}:{fns}fns|{structs}structs {sig1} {ln}L]"
code_rust = "[{type}:{fns}fns|{structs}structs|{impls}impls {sig1} {ln}L]"
code_python = "[{type}:{fns}fns|{classes}classes {sig1} {ln}L]"
code_go = "[{type}:{fns}fns|{types}types {sig1} {ln}L]"
code_js = "[{type}:{fns}fns|{classes}classes {sig1} {ln}L]"
_default = "[{type}:{first}]"


# ── CCR marker templates: the three-line output block ────────────────────────
[templates.marker]
# {preview}  = rendered preview string
# {type}     = content/marker type
# {meta}     = metadata string (key=val;key=val)
# {center}   = center annotation
# {hash}     = full hash
# {size}     = byte size
# {hint}     = optional retrieve hint ("" when disabled)
format = "{preview}\n[{type}: {meta}{center_seg}]\n<<<CCR:{hash}|{type}|{size}>>>"
hint = "…(use aphrodite_retrieve)"


# ── Prompt guidance templates ────────────────────────────────────────────────
[templates.prompts]

# Session injection: shown once at session start (Layer 1 instruction)
session_inject = "CCR markers (<<<CCR:hash|type|size>>>) are compressed content the engine stored. aphrodite_retrieve(hash) returns the original. If auto_expand is on, tool outputs are already expanded - no markers appear. aphrodite_catalog lists all stored entries."

# Context engine: shown when messages are offloaded to CCR
engine_offload = "These messages were offloaded to reduce context. Use aphrodite_retrieve({hash}) if needed. The {tail} messages below are your active context."

# Auto-expand guidance: shown when auto-expand is active
auto_expand_guidance = "💋 Tool outputs are auto-expanded - you see full content inline, no <<<CCR:...>>> markers for tool results. If you see a CCR marker, retrieve only if the preview hints at useful content."

# Catalog context warning: shown when context exceeds threshold
catalog_context_warn = "⚠ context={ctx} msgs - prefer catalog over scanning history"

# Search hint: shown in aphrodite_search results
search_hint = "Use aphrodite_retrieve(hash) to expand any result hash."

# ══════════════════════════════════════════════════════════════════════════════
#  DIRECTIVES  -  conversational behavioral context (swappable .md files)
# ══════════════════════════════════════════════════════════════════════════════
[directives]
# Active directives loaded from directives/*.md at startup.
# Swap mid-conversation via aphrodite_directive("swap", "explore").
active = ["focus", "foresight"] # restored per standing feedback (feedback.md): CCR-first retrieval + anticipate/prefetch


# ══════════════════════════════════════════════════════════════════════════════
#  FLOW  -  per-turn injected-context assembler (report 05)
# ══════════════════════════════════════════════════════════════════════════════
[flow]
# Hard cap for ALL per-turn injected context (directives + nudges + recall
# catalog + retrieve hint). Kept below Hermes's 10k-char spill threshold so the
# catalog is never spill-mangled. Sections drop bottom-up when over budget;
# directives and nudges never drop. Env: APHRODITE_FLOW_BUDGET_CHARS.
budget_chars = 2600


# ── Reverse key map: type aliases for template resolution ────────────────────
# Maps classifier output types to template keys. Allows granular routing.
[templates.reverse]
build_output = "build_output"
build_error = "build_error"
error = "error"
diff = "diff"
terminal = "terminal"
commit = "commit"
search_files = "search_files"
search_results = "search_results"
tabular = "tabular"
json = "json"
json_list = "json_list"
process_output = "process_output"
write_file = "write_file"
log = "log"
browser_snapshot = "browser_snapshot"
web_search = "web_search"
image_generate = "image_generate"
todo = "todo"
memory = "memory"
cronjob = "cronjob"
code = "code"
code_rust = "code_rust"
code_python = "code_python"
code_go = "code_go"
code_js = "code_js"
code_ts = "code_ts"
code_sh = "code_sh"
text = "_default"
