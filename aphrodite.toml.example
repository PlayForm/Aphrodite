# ── Aphrodite Configuration ────────────────────────────────────────────────
# Copy this file to aphrodite.toml and edit to your needs.
# Priority (a subset of fields only - see docs/config/env-vars.md):
# env var > aphrodite.toml > hardcoded default.
#
# Search order: ./aphrodite.toml, then ~/.hermes/aphrodite/aphrodite.toml
# (only when APHRODITE_CONFIG_PATH is NOT set - an explicit override that
# doesn't exist falls through to single-proxy CLI-flag mode instead).

# ── Proxies ─────────────────────────────────────────────────────────────────
[[proxies]]
name = "cache"
listen = "0.0.0.0:9797"
mode = "cache"
tool_relay = true
timeout = 120

[[proxies]]
name = "token"
listen = "0.0.0.0:9798"
mode = "token"
tool_relay = true
timeout = 300

# ── Shared defaults (applied to all proxies unless overridden) ──────────────
[defaults]
api_url = "https://api.deepseek.com"
model = "deepseek-v4-pro"
ccr_ttl_seconds = 3600
# api_key is read from APHRODITE_API_KEY env var.
# Only uncomment if you cannot use the env var:
# api_key = "sk-..."

# ── Compression ─────────────────────────────────────────────────────────────
[compression]
engine_threshold_pct = 45          # compress at 45% context
engine_protect_first = 2           # messages to keep at start
engine_protect_last = 5            # messages to keep at end
engine_min_msgs = 8                # minimum messages before activating
tool_threshold_token = 512         # token proxy threshold (bytes)
tool_threshold_cache = 4096        # cache proxy threshold (bytes)
terminal_threshold = 1024          # terminal output threshold (bytes)
inline_threshold = 2048            # inline zlib fallback threshold (bytes)
auto_expand = false                # off: markers stay raw
auto_expand_limit = 0              # 0 = disabled
catalog_mode = "tool"              # compact | full | tool
classifier_poll = true             # skip CCR for clean outputs
code_multiplier = 3.0              # multiply threshold for code types
context_engine = true              # default-on, no env var needed
prefetch = true                    # enable aphrodite_prefetch tool

# ── Previews ─────────────────────────────────────────────────────────────────
[previews]
model_family = "code_first"        # compact | code_first | balance
code_structure_map = true          # show fn/struct/class sigs
preview_max_chars = 120            # max chars per preview line

# ── Prompts ──────────────────────────────────────────────────────────────────
[prompts]
retrieve_guidance = "verbose"      # minimal | standard | verbose
ccr_marker_hint = true             # append "…(use aphrodite_retrieve)"?
catalog_intent_hints = true        # show intent=read with hashes?
