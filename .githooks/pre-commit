#!/usr/bin/env bash
# pre-commit - repo-guard + ggshield secret scan before each commit.
# Installed via: git config core.hooksPath .githooks
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Guard: refuse to commit if any submodule is checked out BEHIND its
# configured tracking branch tip (e.g. `Source/Current`). A plain
# `git submodule update --remote` (which defaults to the non-existent
# `origin` remote for these submodules and silently falls back to the
# recorded pin) can leave a submodule on a stale SHA; committing that
# would persist the downgrade. Re-float first with `git submodule
# update --remote` (now correct via submodule.<n>.remote = Source) or
# run the float hook, then re-stage.
if [ -f "$REPO_ROOT/.gitmodules" ]; then
  guard_failed=""
  while IFS=' ' read -r key path; do
    [ -e "$REPO_ROOT/$path/.git" ] || continue
    name=$(echo "$key" | sed -e 's/^submodule\.//' -e 's/\.path$//')
    branch=$(git config -f "$REPO_ROOT/.gitmodules" --get "submodule.$name.branch" 2>/dev/null)
    [ -n "$branch" ] || continue
    tip=$(git -C "$REPO_ROOT/$path" rev-parse --verify -q "Source/$branch" 2>/dev/null)
    [ -n "$tip" ] || continue
    head=$(git -C "$REPO_ROOT/$path" rev-parse HEAD 2>/dev/null)
    if [ "$head" != "$tip" ] && git -C "$REPO_ROOT/$path" merge-base --is-ancestor "$head" "$tip" 2>/dev/null; then
      guard_failed="$guard_failed $path (behind Source/$branch: $head -> $tip)"
    fi
  done < <(git config -f "$REPO_ROOT/.gitmodules" --get-regexp '\.path$' 2>/dev/null)
  if [ -n "$guard_failed" ]; then
    echo "pre-commit: submodule(s) checked out behind their tracking-branch tip:" >&2
    echo "  $guard_failed" >&2
    echo "  Fix: re-float with 'git submodule update --remote' (uses Source via .gitmodules)," >&2
    echo "  then 'git add' the gitlink(s) and commit again." >&2
    exit 1
  fi
fi

# Gate: skip entirely in CI.
if [ -n "${CI:-}" ]; then
	exit 0
fi

# Always run the repo-specific guard (no external dependency, fast) -
# runtime-state/profile tracking + credential-pattern content scan.
"$REPO_ROOT/Maintain/scripts/ops/check-no-runtime-state.sh"

# ggshield is a broader, optional secret scan on top - skip gracefully if
# not installed rather than blocking every commit on it.
if ! command -v ggshield &>/dev/null; then
	echo "pre-commit: ggshield not found - install with: pip install ggshield"
	echo "pre-commit: skipping ggshield scan (repo-guard check above still ran)"
	exit 0
fi

exec ggshield secret scan pre-commit "$@"
