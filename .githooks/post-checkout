#!/usr/bin/env bash
# post-checkout - keep this submodule ON its configured tracking branch and
# the parent's gitlink in sync. Runs for BOTH repos (they share .githooks/).
# In a submodule:
#   1. If HEAD is detached and the branch configured for this submodule in
#      the superproject's .gitmodules exists (`Current` on the Current
#      branch, `Development` on Development - whatever `submodule.<name>.
#      branch` says; falls back to `Current` when unset), jump back onto it
#      (parent checkouts / `git submodule update` detach the submodule HEAD;
#      we always work on the tracking branch so commits can never dangle).
#   2. Then bump the parent's gitlink to HEAD (no stale "+" / "M submodule").
# In a plain repo: no-op. The force-tracking-branch rule deliberately
# overrides ad-hoc detaches in this working copy - use `git show`/worktrees
# to inspect old commits.
set -euo pipefail

SUPER="$(git rev-parse --show-superproject-working-tree 2>/dev/null || true)"
if [[ -z "$SUPER" ]]; then
	exit 0
fi

# Resolve this submodule's configured tracking branch from the
# superproject's .gitmodules (same lookup as pre-commit / sync-submodules.sh).
SUB_TOP="$(git rev-parse --show-toplevel)"
SUB_REL="$(python3 -c "import os,sys;print(os.path.relpath(sys.argv[1],sys.argv[2]))" "$SUB_TOP" "$SUPER")"
BRANCH="Current"
while IFS=' ' read -r key path; do
	if [ "$path" = "$SUB_REL" ]; then
		name=$(echo "$key" | sed -e 's/^submodule\.//' -e 's/\.path$//')
		configured=$(git config -f "$SUPER/.gitmodules" --get "submodule.$name.branch" 2>/dev/null)
		[ -n "$configured" ] && BRANCH="$configured"
		break
	fi
done < <(git config -f "$SUPER/.gitmodules" --get-regexp '\.path$' 2>/dev/null)

if ! git symbolic-ref -q HEAD >/dev/null 2>&1 && git show-ref --verify --quiet "refs/heads/$BRANCH"; then
	git checkout "$BRANCH" >/dev/null 2>&1 || true
fi

DIR="$(cd "$(dirname "$0")" && pwd)"
exec "$DIR/lib/bump-submodule-gitlink.sh"