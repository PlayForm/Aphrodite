#!/usr/bin/env bash
# post-checkout - two responsibilities, in this order:
#
#  1. NEVER leave any repo/worktree/submodule on a detached HEAD: if this
#     checkout left HEAD detached but the commit is contained in a branch,
#     re-attach to that branch immediately (the user's standing invariant:
#     every repo stays on its branch - no dangling commits). Runs FIRST
#     because `git checkout <sha>` fires this hook with $3=1 (a HEAD-moving
#     checkout), so the re-attach must not be gated on the file-checkout flag.
#  2. On a branch checkout in the parent, auto-commit any updated submodule
#     gitlinks (delegated to lib/bump-submodule-gitlinks.sh).
#
# Args: $1 old HEAD, $2 new HEAD, $3 flag (1 = branch/HEAD checkout,
# 0 = file checkout).
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"

# ── Responsibility 1: detached-HEAD re-attach (runs FIRST, any flag) ──
# Recursion guard: our own `git checkout` below fires this hook again.
if [[ -z "${DETACH_REATTACH_ACTIVE:-}" ]] && ! git symbolic-ref -q HEAD >/dev/null 2>&1; then
	HEAD_SHA="$(git rev-parse HEAD)"
	# `git branch --contains` lists "(no branch)" for the detached HEAD
	# itself - exclude it so the candidate set is real branches only.
	HITS="$(git branch --contains "$HEAD_SHA" 2>/dev/null | sed 's/^[*+] //' | grep -v '^$' | grep -v '^(no branch)' || true)"
	if [ -z "$HITS" ]; then
		# Commit on no branch - genuinely dangling, cannot auto-pick a target.
		echo "post-checkout: WARNING HEAD is detached at $HEAD_SHA and the commit is on NO branch - attach manually" >&2
	else
		# Choose: Current (release line) > Development > first hit (stable order).
		TARGET="$(echo "$HITS" | grep -x 'Current' || true)"
		if [ -z "$TARGET" ]; then
			TARGET="$(echo "$HITS" | grep -x 'Development' || true)"
		fi
		if [ -z "$TARGET" ]; then
			TARGET="$(echo "$HITS" | head -1)"
		fi
		echo "post-checkout: re-attaching detached HEAD ($HEAD_SHA) to branch '$TARGET'"
		DETACH_REATTACH_ACTIVE=1 git checkout "$TARGET" >/dev/null 2>&1 || true
		exit 0
	fi
fi

# ── Responsibility 2: gitlink auto-bump (parent only, guarded in the lib) ──
if [ "${3:-0}" = "1" ]; then
	exec "$DIR/lib/bump-submodule-gitlinks.sh"
fi
exit 0
