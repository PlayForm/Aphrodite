# Exclude Hermes agent workspace from release archives
.hermes/ export-ignore

# Normalize line endings for source files
*.py    text eol=lf
*.rs    text eol=lf
*.toml  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.env   text eol=lf

# Binary files
*.png   binary
*.jpg   binary
*.ico   binary
*.gz    binary
