+"""
+headroom_native — Hermes middleware for transparent CCR resolution.
+
+When HERMES_HEADROOM_NATIVE=1, this middleware scans API request messages
+for headroom CCR markers (<<ccr:hash,...>> or [N items compressed...])
+and resolves them via the proxy's /v1/retrieve endpoint BEFORE the
+request reaches the provider proxy — breaking the re-compression loop.
+
+Proxy-aware: when the provider base_url already points to a local headroom
+proxy (127.0.0.1 / localhost), the middleware ONLY resolves CCR markers
+(no inline compression — the proxy handles that).  When the provider is
+direct (api.deepseek.com), the middleware BOTH resolves CCR markers AND
+optionally compresses inline via the headroom Python library.
+
+Enable:
+    export HERMES_HEADROOM_NATIVE=1
+    hermes --provider deepseek-proxy-token  # proxy-aware: skip inline compression
+    hermes --provider deepseek-direct       # proxy-aware: compress inline + resolve CCR
+
+Install:
+    Apply this patch to ~/.hermes/hermes-agent/.
+    The plugin auto-detects this module and registers the middleware.
+"""
+from __future__ import annotations
+
+import json
+import os
+import re
+import urllib.request
+from typing import Any
+
+PROXY_RETRIEVE = "http://127.0.0.1:8788/v1/retrieve"
+_CCR_RE = re.compile(r"<<ccr:([a-f0-9]{6,64})")
+_HASH_RE = re.compile(r'hash[=:\s]*([a-f0-9]{6,64})', re.I)
+_COMPRESS_ENGINE = None
+
+
+def _is_proxy(base_url: str) -> bool:
+    """True if the provider routes through a local headroom proxy."""
+    return "127.0.0.1" in base_url or "localhost" in base_url
+
+
+def _resolve_hash(hash_key: str) -> str | None:
+    """Resolve a single CCR hash via the proxy's retrieve endpoint."""
+    try:
+        req = urllib.request.Request(
+            PROXY_RETRIEVE,
+            data=json.dumps({"hash": hash_key}).encode(),
+            headers={"Content-Type": "application/json"},
+        )
+        data = json.loads(urllib.request.urlopen(req, timeout=5).read())
+        content = data.get("original_content", "")
+        if content and not content.lstrip().startswith("<<ccr:"):
+            return content
+    except Exception:
+        pass
+    return None
+
+
+def _resolve_ccr_in_messages(messages: list[dict]) -> int:
+    """Scan messages for CCR markers and resolve them in-place.
+    Returns the number of markers resolved.
+    """
+    if not messages:
+        return 0
+    resolved = 0
+    for i, msg in enumerate(messages):
+        content = msg.get("content", "")
+        if not isinstance(content, str) or not content.strip():
+            continue
+        # Find CCR hashes
+        hashes = _CCR_RE.findall(content)
+        if not hashes and "items compressed" in content[:500]:
+            m = _HASH_RE.search(content[:500])
+            if m:
+                hashes = [m.group(1)]
+        if not hashes:
+            continue
+        # Resolve via proxy
+        for h in hashes:
+            c = _resolve_hash(h)
+            if c:
+                messages[i] = {**msg, "content": c}
+                resolved += 1
+                break
+    return resolved
+
+
+def _compress_inline(messages: list[dict]) -> list[dict]:
+    """Compress messages inline using the headroom library.
+    Only used when provider is direct (not through proxy).
+    """
+    global _COMPRESS_ENGINE
+    if _COMPRESS_ENGINE is None:
+        try:
+            from hermes_compress import Compress, CompressOption
+            opt = CompressOption()
+            opt.Enabled = True
+            opt.Mode = "inline"
+            opt.ProtectRecent = 1
+            opt.MinTokensToCompress = 100
+            opt.TargetRatio = None
+            opt.PrecompressTools = True
+            opt.AggressiveKompress = True
+            opt.DeduplicateResults = True
+            _COMPRESS_ENGINE = Compress(model="deepseek-v4-pro", option=opt)
+        except Exception:
+            _COMPRESS_ENGINE = False
+    if not _COMPRESS_ENGINE or _COMPRESS_ENGINE is False:
+        return messages
+    try:
+        result = _COMPRESS_ENGINE.compress(messages)
+        return result.messages
+    except Exception:
+        return messages
+
+
+def on_llm_request(**kwargs: Any) -> dict | None:
+    """llm_request middleware entry point."""
+    if not os.environ.get("HERMES_HEADROOM_NATIVE") == "1":
+        return None
+
+    request = dict(kwargs.get("request", {}))
+    msgs = request.get("messages")
+    if not msgs:
+        return None
+
+    base_url = str(kwargs.get("base_url", ""))
+    using_proxy = _is_proxy(base_url)
+
+    # Always resolve CCR markers (prevents re-compression loop)
+    _resolve_ccr_in_messages(msgs)
+
+    # If direct API, also compress inline for token savings
+    if not using_proxy and len(msgs) > 2:
+        msgs = _compress_inline(msgs)
+
+    request["messages"] = msgs
+    return {"request": request, "source": "headroom-native"}
+
+
+# Auto-register if plugin context is available
+def register(ctx: Any) -> None:
+    if os.environ.get("HERMES_HEADROOM_NATIVE") == "1":
+        ctx.register_middleware("llm_request", on_llm_request)
