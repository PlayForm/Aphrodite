#!/usr/bin/env python3
"""
Hermes Wrap — launch Hermes through headroom proxy compression.

Like Headroom wraps Claude Code, this wraps Hermes Agent.
Starts the headroom proxy, configures Hermes to route through it,
and launches hermes in TUI mode.  All LLM calls are compressed.

Usage:
    hermes-wrap [--port 8787] [--mode cache|token] [--stats]
    hermes-wrap --background     # Start proxy only, no TUI
    hermes-wrap --proxy-only     # Start proxy, print URL for manual config
    hermes-wrap --stop           # Kill running proxy

With --background: proxy runs silently, you can fire `hermes chat --tui`
separately after configuring base_url.
"""

import argparse, json, os, signal, subprocess, sys, time, urllib.request
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
VENV = REPO / ".venv"
HEADROOM = VENV / "bin" / "headroom"
DEEPSEEK_URL = "https://api.deepseek.com"
DEFAULT_PORT = 8787


def _load_env():
    """Load .env if present, return API key."""
    env_file = REPO / ".env"
    if env_file.exists():
        for line in env_file.read_text().splitlines():
            line = line.strip()
            if line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            if k.strip() == "HEADROOM_DEEPSEEK_KEY":
                return v.strip().strip('"').strip("'")
    return os.getenv("HEADROOM_DEEPSEEK_KEY", "")


def _health(port):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/health", timeout=3) as r:
            return json.loads(r.read()).get("ready", False)
    except Exception:
        return False


def _stats(port):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/stats", timeout=3) as r:
            return json.loads(r.read())
    except Exception:
        return {}


def start_proxy(port, mode):
    """Start headroom proxy. Returns subprocess.Popen or None."""
    key = _load_env()
    if not key:
        print("ERROR: HEADROOM_DEEPSEEK_KEY not set in .env or environment", file=sys.stderr)
        return None

    # Kill any existing proxy on this port
    try:
        subprocess.run(["pkill", "-f", f"headroom proxy.*{port}"],
                       capture_output=True, timeout=5)
        time.sleep(0.5)
    except Exception:
        pass

    if not HEADROOM.exists():
        print(f"ERROR: headroom not found at {HEADROOM}", file=sys.stderr)
        return None

    proc = subprocess.Popen(
        [str(HEADROOM), "proxy", "--port", str(port), "--mode", mode,
         "--backend", "openai", "--openai-api-url", DEEPSEEK_URL],
        env={**os.environ,
             "OPENAI_BASE_URL": DEEPSEEK_URL,
             "OPENAI_API_KEY": key},
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    # Wait for ready
    for _ in range(15):
        time.sleep(1)
        if _health(port):
            return proc
    proc.terminate()
    return None


def stop_proxy(port):
    try:
        subprocess.run(["pkill", "-f", f"headroom proxy.*{port}"],
                       capture_output=True, timeout=5)
    except Exception:
        pass


def configure_hermes(port):
    """Set Hermes base_url to route through proxy."""
    result = subprocess.run(
        ["hermes", "config", "set", "model.base_url",
         f"http://127.0.0.1:{port}/v1"],
        capture_output=True, text=True, timeout=10,
    )
    if result.returncode != 0:
        print(f"WARNING: Could not configure hermes: {result.stderr}", file=sys.stderr)
        return False
    print(f"✓ Hermes configured: base_url = http://127.0.0.1:{port}/v1")
    return True


def main():
    parser = argparse.ArgumentParser(
        description="Launch Hermes through headroom proxy compression")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT,
                        help=f"Proxy port (default: {DEFAULT_PORT})")
    parser.add_argument("--mode", choices=["cache", "token"], default="cache",
                        help="Proxy mode: cache (full pipeline) or token (compression only)")
    parser.add_argument("--background", action="store_true",
                        help="Start proxy only, no TUI")
    parser.add_argument("--proxy-only", action="store_true",
                        help="Start proxy, print config, exit")
    parser.add_argument("--stats", action="store_true",
                        help="Show proxy stats after exit")
    parser.add_argument("--stop", action="store_true",
                        help="Kill running proxy and exit")
    parser.add_argument("hermes_args", nargs="*",
                        help="Additional args passed to hermes (e.g., chat --tui)")
    args = parser.parse_args()

    # --stop
    if args.stop:
        stop_proxy(args.port)
        print(f"Proxy on port {args.port} stopped.")
        return

    # Check if already running
    if _health(args.port):
        print(f"Proxy already running on port {args.port}")
    else:
        print(f"Starting headroom proxy on :{args.port} ({args.mode} mode)...")
        proxy = start_proxy(args.port, args.mode)
        if not proxy:
            print("ERROR: Failed to start proxy", file=sys.stderr)
            sys.exit(1)
        print(f"✓ Proxy healthy — {args.mode} mode, backend: DeepSeek")

    # --proxy-only: print config and exit
    if args.proxy_only:
        print(f"\nTo use:  hermes config set model.base_url http://127.0.0.1:{args.port}/v1")
        print(f"         hermes chat --tui")
        print(f"\nStats:   curl http://127.0.0.1:{args.port}/stats")
        sys.exit(0)

    # Configure hermes
    configure_hermes(args.port)

    base_url = f"http://127.0.0.1:{args.port}/v1"
    print(f"\nRouting: hermes → {base_url} → headroom → {DEEPSEEK_URL}")
    print(f"Mode: {args.mode} | Port: {args.port}")

    if args.background:
        print("Proxy running in background. Use --stop to kill.")
        print(f"Stats: curl http://127.0.0.1:{args.port}/stats")
        return

    # Launch hermes TUI
    hermes_args = args.hermes_args or ["chat", "--tui"]
    print(f"\nLaunching: hermes {' '.join(hermes_args)}")
    print("(All LLM calls compressed through headroom)\n")

    try:
        subprocess.run(["hermes"] + hermes_args)
    except KeyboardInterrupt:
        pass
    finally:
        if args.stats:
            s = _stats(args.port)
            if s:
                comp = s.get("summary", {}).get("compression", {})
                print(f"\n── Proxy Stats ──")
                print(f"  Requests: {s['summary'].get('api_requests', 0)}")
                print(f"  Compressed: {comp.get('requests_compressed', 0)}")
                print(f"  Tokens removed: {comp.get('total_tokens_removed', 0):,}")
                print(f"  Avg compression: {comp.get('avg_compression_pct', 0):.1f}%")
                print(f"  Cache hits: {s.get('cache', {}).get('total_hits', 0)}")
        if not args.background:
            stop_proxy(args.port)
            print("Proxy stopped.")


if __name__ == "__main__":
    main()
